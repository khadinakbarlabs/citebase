{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__[A-Za-z0-9_.-]*([Ss]end|[Rr]eply|[Ff]orward|[Cc]ampaign|[Cc]art|[Cc]heckout|[Pp]urchase|[Bb]uy|call-actor|--)[A-Za-z0-9_.-]*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/approval_gate.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__[A-Za-z0-9_.-]*([Ss]end|[Rr]eply|[Ff]orward|call-actor)[A-Za-z0-9_.-]*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/approval_gate.py\" post"
          }
        ]
      }
    ]
  }
}
